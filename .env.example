# GEMINI_API_KEY (OPSİYONEL): AI piyasa yorum katmanı için Google Gemini API anahtarı.
# Tanımsız bırakılırsa uygulama sorunsuz çalışır; sinyal yorumları yerel esprili
# fallback havuzundan üretilir (lib/commentary.ts).
# AI Studio runtime'da kullanıcı secret'lerinden otomatik enjekte eder.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL (OPSİYONEL): Kullanılacak Gemini modeli. Varsayılan: gemini-2.0-flash
# GEMINI_MODEL="gemini-2.0-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
